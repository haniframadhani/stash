APP_NAME=Guren
APP_KEY=
APP_URL=http://localhost:3333

PORT=3333
HOST=0.0.0.0

# bun test automatically sets NODE_ENV=test, which points the app at
# TEST_DATABASE_URL instead, so this line is only used outside tests.
DATABASE_URL=./data/guren.db
# Blank uses ./data/guren.test.db. Set it to shard parallel CI runs.
TEST_DATABASE_URL=

# Optional: the port the dev server starts Vite on (5173 when unset). Vite
# takes the next free port when it is busy, and the banner shows the one in use.
# GUREN_VITE_PORT=5173

# Optional: point to an already-running external Vite dev server.
# VITE_DEV_SERVER_URL=http://localhost:5173

# Storage: image bytes only go through Guren's StorageManager (PLANNING.md §10).
# local = a folder on disk, no S3 needed. s3 = any S3-compatible endpoint below.
STORAGE_DISK=local
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=secret
S3_BUCKET=my-bucket
S3_REGION=us-east-1

# Absolute base for copied share links. Blank falls back to APP_URL.
PUBLIC_BASE_URL=http://localhost:3333

# Single seeded owner (PLANNING.md §9). Used by the seeder; the password is stored hashed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Image pipeline (docs/IMAGE_PIPELINE.md §1 to §2).
MAX_UPLOAD_MB=50
MAX_PIXELS=100000000
CONVERT_CONCURRENCY=2
KEEP_VERSIONS=5
DEFAULT_FORMAT=webp
DEFAULT_QUALITY_WEBP=80
DEFAULT_QUALITY_AVIF=55
AVIF_EFFORT=4

# Days a trashed item stays before the scheduled purge (PLANNING.md §6).
TRASH_RETENTION_DAYS=30

# Which store config/session.ts uses. `database` needs the sessions table
# and its migration; `cookie` needs neither, and caps the session at ~2.9 KB.
SESSION_DRIVER=database
# SESSION_DRIVER=memory
# SESSION_DRIVER=cookie

# The browser account's password: db/seeders/browser-account.ts seeds it while `guren browser:serve` runs the app, and the Playwright setup project signs in with it.
BROWSER_TEST_PASSWORD=
