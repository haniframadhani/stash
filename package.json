{
  "name": "file-management-s3",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "bunx guren codegen --force",
    "dev": "bun run codegen && GUREN_MCP=1 GUREN_DOCS=1 bun run dev:server",
    "dev:server": "NODE_ENV=development bun --hot bin/serve.ts",
    "console": "bun bin/console.ts",
    "storage:check": "bun bin/storage-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix",
    "test": "bun test",
    "build": "bun run codegen && bunx vite build && bunx vite build --mode mcp-app",
    "preview": "NODE_ENV=production bun bin/serve.ts",
    "start": "NODE_ENV=production bun bin/serve.ts",
    "db:make": "bunx guren make:migration",
    "db:migrate": "bunx guren db:migrate",
    "db:reset": "bunx guren db:reset",
    "db:status": "bunx guren db:status",
    "db:seed": "bunx guren db:seed",
    "test:browser": "playwright test -c playwright.browser.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@guren/cli": "^2.36.1",
    "@guren/core": "^1.26.1",
    "@guren/inertia-client": "^1.4.0",
    "@guren/orm": "^2.15.0",
    "@inertiajs/react": "^3.11.0",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "^1.70.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@guren/testing": "^1.14.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "bun-types": "^1.3.1",
    "drizzle-kit": "1.0.0-rc.4",
    "oxlint": "~1.81.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  }
}
